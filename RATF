local function hasFastSummon()
	if LocalPlayer:GetAttribute("FastSummon") then
		return true
	end
	local now = workspace:GetServerTimeNow()
	local fastEnd = tonumber(LocalPlayer:GetAttribute("FastRollEndsAt")) or 0
	if now < fastEnd then return true end
	local globalEnd = tonumber(workspace:GetAttribute("FastRollEndsAt")) or 0
	return now < globalEnd
end

local function getDefaultDelay()
	return if hasFastSummon() then 0.6 else 2.2
end

