local function unequipAllTools(humanoid)
	if humanoid then
		humanoid:UnequipTools()
		task.wait(0.15)
	end
end

local function getAllInventoryTools()
	local tools = {}
	local character = LocalPlayer.Character
	local backpack = LocalPlayer:FindFirstChild("Backpack")

	if backpack then
		for _, item in backpack:GetChildren() do
			if item:IsA("Tool") then
				table.insert(tools, item)
			end
		end
	end
	if character then
		for _, item in character:GetChildren() do
			if item:IsA("Tool") then
				table.insert(tools, item)
			end
		end
	end

	return tools
end

local function isUnitSelected(name)
	local selected = Options.LevelUpUnits and Options.LevelUpUnits.Value or {}
	if selected[name] == true then return true end

	local dName = NameToDisplayName[name]
	if dName and selected[dName] == true then return true end

	local iName = DisplayNameToName[name]
	if iName and selected[iName] == true then return true end

	return false
end

local function getPromptWorldCFrame(prompt)
	if not prompt then return nil end
	local parent = prompt.Parent
	if parent:IsA("Attachment") then
		return parent.WorldCFrame + Vector3.new(0, 2.2, 0)
	elseif parent:IsA("BasePart") then
		return parent.CFrame + Vector3.new(0, 2.2, 0)
	end
	return nil
end

local function triggerPromptWithTeleport(prompt, hrp, originalPos)
	local targetCF = getPromptWorldCFrame(prompt)
	if not targetCF or not hrp then return end

	hrp.CFrame = targetCF
	task.wait(0.15)

	pcall(function()
		fireproximityprompt(prompt)
	end)
	task.wait(0.25)

	if originalPos then
		hrp.CFrame = originalPos
		task.wait(0.1)
	end
end

local function performFullAutoFusion()
	if State.isFusing then return end
	State.isFusing = true

	local ok, err = pcall(function()
		local plot = getMyPlot()
		if not plot then return end

		local charactersFolder = plot:FindFirstChild("Characters")
		local placementFolder = plot:FindFirstChild("Placement")
		if not charactersFolder or not placementFolder then return end

		local character = LocalPlayer.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local hrp = character and character:FindFirstChild("HumanoidRootPart")
		if not character or not humanoid or not hrp then return end

		local selectedUnits = Options.LevelUpUnits and Options.LevelUpUnits.Value or {}
		local anyUnitSelected = false
		for _, v in selectedUnits do
			if v == true then anyUnitSelected = true; break end
		end
		if not anyUnitSelected then return end

		local maxLvlCap = tonumber(Options.MaxLevelUp and Options.MaxLevelUp.Value) or 7
		local originalPos = hrp.CFrame

		local occupiedSlots = {}
		local placedList = {}
		for _, c in charactersFolder:GetChildren() do
			local slotNum = tonumber(c:GetAttribute("Slot"))
			if slotNum then
				local unitInfo = {
					slot = slotNum,
					model = c,
					name = c:GetAttribute("CharacterName") or c.Name,
					level = tonumber(c:GetAttribute("Level")) or 1,
					mutation = c:GetAttribute("Mutation") or ""
				}
				occupiedSlots[slotNum] = unitInfo
				table.insert(placedList, unitInfo)
			end
		end

		local slotPrompts = {}
		for _, slotModel in placementFolder:GetChildren() do
			local slotNum = tonumber(slotModel.Name:match("%d+"))
			if slotNum then
				local prompt = slotModel:FindFirstChildWhichIsA("ProximityPrompt", true)
				if prompt then
					slotPrompts[slotNum] = prompt
				end
			end
		end

		local allTools = getAllInventoryTools()

		-- STEP 1: Direct Fusion on Placed Units
		for _, placed in placedList do
			if isUnitSelected(placed.name) and placed.level < maxLvlCap and placed.level < 7 then
				local matchingTool = nil
				for _, tool in allTools do
					local toolName = tool.Name
					local toolLevel = tonumber(tool:GetAttribute("Level")) or 1
					local toolMutation = tool:GetAttribute("Mutation") or ""
					if (toolName == placed.name or NameToDisplayName[toolName] == placed.name) and toolLevel == placed.level and toolMutation == placed.mutation then
						matchingTool = tool
						break
					end
				end

				if matchingTool then
					local prompt = slotPrompts[placed.slot]
					if prompt then
						if matchingTool.Parent ~= character then
							humanoid:EquipTool(matchingTool)
							task.wait(0.2)
						end
						triggerPromptWithTeleport(prompt, hrp, originalPos)
						return
					end
				end
			end
		end

		-- STEP 2: Cross-Slot Fusion
		for i = 1, #placedList do
			for j = i + 1, #placedList do
				local p1 = placedList[i]
				local p2 = placedList[j]
				if isUnitSelected(p1.name) and p1.name == p2.name and p1.level == p2.level and p1.mutation == p2.mutation and p1.level < maxLvlCap and p1.level < 7 then
					local prompt2 = slotPrompts[p2.slot]
					local prompt1 = slotPrompts[p1.slot]
					if prompt2 and prompt1 then
						unequipAllTools(humanoid)
						triggerPromptWithTeleport(prompt2, hrp, nil)

						allTools = getAllInventoryTools()
						for _, tool in allTools do
							local toolName = tool.Name
							local toolLevel = tonumber(tool:GetAttribute("Level")) or 1
							local toolMutation = tool:GetAttribute("Mutation") or ""
							if (toolName == p1.name or NameToDisplayName[toolName] == p1.name) and toolLevel == p1.level and toolMutation == p1.mutation then
								humanoid:EquipTool(tool)
								task.wait(0.2)
								triggerPromptWithTeleport(prompt1, hrp, originalPos)
								break
							end
						end
						return
					end
				end
			end
		end

		-- STEP 3: Bag-to-Slot Initial Placement & Pair Merging
		local emptySlotPrompt = nil
		for slotNum, prompt in slotPrompts do
			if not occupiedSlots[slotNum] then
				emptySlotPrompt = prompt
				break
			end
		end

		if emptySlotPrompt then
			local toolGroups = {}
			for _, tool in allTools do
				local toolName = tool.Name
				local toolLevel = tonumber(tool:GetAttribute("Level")) or 1
				local toolMutation = tool:GetAttribute("Mutation") or ""
				if isUnitSelected(toolName) and toolLevel < maxLvlCap and toolLevel < 7 then
					local key = string.format("%s_%d_%s", toolName, toolLevel, toolMutation)
					if not toolGroups[key] then toolGroups[key] = {} end
					table.insert(toolGroups[key], tool)
				end
			end

			for _, group in toolGroups do
				if #group >= 2 then
					local tool1 = group[1]
					local tool2 = group[2]

					humanoid:EquipTool(tool1)
					task.wait(0.2)
					triggerPromptWithTeleport(emptySlotPrompt, hrp, nil)

					humanoid:EquipTool(tool2)
					task.wait(0.2)
					triggerPromptWithTeleport(emptySlotPrompt, hrp, originalPos)
					return
				end
			end

			for _, group in toolGroups do
				if #group >= 1 then
					local tool1 = group[1]
					humanoid:EquipTool(tool1)
					task.wait(0.2)
					triggerPromptWithTeleport(emptySlotPrompt, hrp, originalPos)
					return
				end
			end
		end
	end)

	State.isFusing = false
end

