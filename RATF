local function getOwnedUnitNames()
	local names = {}
	local seen = {}

	local function addUnit(name)
		if not name or name == "" then return end
		local dName = NameToDisplayName[name] or name
		if not seen[dName] then
			seen[dName] = true
			table.insert(names, dName)
		end
	end

	local backpack = LocalPlayer:FindFirstChild("Backpack")
	if backpack then
		for _, item in backpack:GetChildren() do
			if item:IsA("Tool") then
				addUnit(item.Name)
			end
		end
	end

	local char = LocalPlayer.Character
	if char then
		for _, item in char:GetChildren() do
			if item:IsA("Tool") then
				addUnit(item.Name)
			end
		end
	end

	local plot = getMyPlot()
	if plot then
		local chars = plot:FindFirstChild("Characters")
		if chars then
			for _, c in chars:GetChildren() do
				local cName = c:GetAttribute("CharacterName") or c.Name
				addUnit(cName)
			end
		end
	end

	table.sort(names)
	if #names == 0 then
		table.insert(names, "None (Empty Bag)")
	end
	return names
end

