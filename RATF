Library:OnUnload(function()
	-- Save config on unload
	if State.autoSaveConfig then
		pcall(function()
			SaveManager:Save("default")
		end)
	end

	State.autoRoll = false
	State.autoBuy = false
	State.autoUpgrade = false
	State.autoLevelUp = false
	State.autoSpinWheel = false
	State.autoClaimBattlepass = false
	State.autoClaimQuests = false
	State.autoClaimFactionQuests = false
	State.autoFight = false
	State.autoJoinTower = false
	State.autoLuckPotion = false
	State.autoPotionOnMutationEvents = false
	State.waitingForBuy = false
	State.isSpinning = false
	State.isFusing = false

	for _, thread in activeThreads do
		pcall(task.cancel, thread)
	end
	table.clear(activeThreads)

	if rollConnection then
		rollConnection:Disconnect()
		rollConnection = nil
	end
	if spinConnection then
		spinConnection:Disconnect()
		spinConnection = nil
	end
	if factionConnection then
		factionConnection:Disconnect()
		factionConnection = nil
	end

	for plot, parent in originalBaseParents do
		if plot and parent then
			pcall(function() plot.Parent = parent end)
		end
	end
	table.clear(originalBaseParents)
end)

