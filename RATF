local function getBattlepassLevel(exp)
	local totalExp = math.max(0, math.floor(tonumber(exp) or 0))
	local maxLevel = tonumber(BattlepassReward.Config.MaxLevel) or 30
	local currentLevel = 0
	local accumulated = 0

	for i = 1, maxLevel do
		local reward = BattlepassReward.Rewards[i]
		local needed = reward and math.max(0, math.floor(tonumber(reward.EXP) or 0)) or math.huge
		if accumulated + needed <= totalExp then
			currentLevel = i
			accumulated = accumulated + needed
		else
			break
		end
	end

	return currentLevel, maxLevel
end

