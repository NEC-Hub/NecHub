local function shouldBuyCharacter(charData)
	if not State.autoBuy then return false end
	if charData.Purchased then return false end

	local selectedChars = Options.BuyCharacters and Options.BuyCharacters.Value or {}

	local anyCharSelected = false
	for _, v in selectedChars do
		if v then anyCharSelected = true; break end
	end
	if not anyCharSelected then return false end

	local displayName = charData.DisplayName or charData.Name
	local internalName = charData.Name
	if not selectedChars[displayName] and not selectedChars[internalName] then
		return false
	end

	local selectedMutations = Options.BuyMutations and Options.BuyMutations.Value or {}
	local anyMutationSelected = false
	for _, v in selectedMutations do
		if v then anyMutationSelected = true; break end
	end

	if not anyMutationSelected then return true end

	local charMutation = charData.Mutation
	if charMutation == nil or charMutation == "" or charMutation == "Normal" then
		return selectedMutations["Normal"] == true
	else
		return selectedMutations[charMutation] == true
	end
end

local function setupHooks()
	-- Roll & Webhook Hook
	if rollConnection then
		rollConnection:Disconnect()
		rollConnection = nil
	end

	rollConnection = RollRemote.OnClientEvent:Connect(function(player, plot, charResults, _, rollId)
		if player ~= LocalPlayer then return end
		if not charResults or not rollId then return end

		State.waitingForBuy = true
		task.wait(0.5)

		for slotIndex, charData in charResults do
			if State.autoBuy and shouldBuyCharacter(charData) then
				pcall(function()
					BuyRemote:FireServer(rollId, slotIndex)
					notifyCharacterObtained("Auto Buy", charData, rollId, slotIndex)
				end)
				task.wait(0.15)
			else
				local rarity = charData.Rarity or "Common"
				local hasMutation = charData.Mutation ~= nil and charData.Mutation ~= "" and charData.Mutation ~= "Normal"
				if rarity == "Mythic" or rarity == "Secret" or rarity == "God" or hasMutation then
					notifyCharacterObtained("Rare Roll", charData, rollId, slotIndex)
				end
			end
		end

		State.waitingForBuy = false
	end)

	-- Spin Result Auto-Complete Hook
	if spinConnection then
		spinConnection:Disconnect()
		spinConnection = nil
	end

	spinConnection = SpinRemote.OnClientEvent:Connect(function(arg)
		if not arg then
			State.isSpinning = false
			return
		end
		if arg.Action == "Result" then
			pcall(function()
				SpinRemote:FireServer("Complete", { NotifyText = arg.NotifyText })
			end)
		end
		State.isSpinning = false
	end)

	-- Faction Quest Data Listener
	if factionConnection then
		factionConnection:Disconnect()
		factionConnection = nil
	end

	factionConnection = FactionUpdate.OnClientEvent:Connect(function(action, payload)
		if action == "QuestData" and type(payload) == "table" then
			latestFactionQuests = payload.Daily
		elseif action == "QuestClaim" then
			pcall(function()
				FactionUpdate:FireServer("RequestQuestData")
			end)
		end
	end)
end

