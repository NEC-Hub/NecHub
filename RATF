local function startLoops()
	-- Anti-AFK Hook
	LocalPlayer.Idled:Connect(function()
		if State.antiAfk then
			pcall(function()
				VirtualUser:CaptureController()
				VirtualUser:ClickButton2(Vector2.zero)
			end)
		end
	end)

	-- Auto Roll Loop
	stopThread("autoRoll")
	activeThreads["autoRoll"] = task.spawn(function()
		while true do
			if Library.Unloaded then break end
			if State.autoRoll then
				while State.waitingForBuy or State.isFusing do
					task.wait(0.1)
				end

				local prompt = getRollPrompt()
				if prompt then
					pcall(function()
						fireproximityprompt(prompt)
					end)
				end

				local delay = Options.SummonDelay and Options.SummonDelay.Value or getDefaultDelay()
				task.wait(delay)
			else
				task.wait(0.2)
			end
		end
	end)

	-- Auto Combat & Wave Loop (with Auto Stop Wave support)
	stopThread("autoCombat")
	activeThreads["autoCombat"] = task.spawn(function()
		while true do
			if Library.Unloaded then break end
			if State.autoFight then
				pcall(function()
					local currentWave = getCurrentWave()
					local targetWave = tonumber(Options.TargetStopWave and Options.TargetStopWave.Value) or State.targetStopWave
					local running = isFightRunning()

					if State.autoStopWave and currentWave >= targetWave then
						-- If reached or passed target wave, stop the fight if currently active
						if running then
							FightRemote:FireServer("Stop")
							task.wait(0.5)
						end
					else
						-- Start next fight if not currently in a fight
						if not running then
							FightRemote:FireServer("Start")
							task.wait(0.5)
						end
					end
				end)
				task.wait(1)
			else
				task.wait(1)
			end
		end
	end)

	-- Auto Join Tower Loop
	stopThread("autoTower")
	activeThreads["autoTower"] = task.spawn(function()
		while true do
			if Library.Unloaded then break end
			if State.autoJoinTower then
				pcall(function()
					JoinTowerRemote:FireServer()
				end)
				task.wait(3)
			else
				task.wait(2)
			end
		end
	end)

	-- Auto Potions & Mutation Events Loop
	stopThread("autoPotions")
	activeThreads["autoPotions"] = task.spawn(function()
		while true do
			if Library.Unloaded then break end
			if State.autoLuckPotion or State.autoPotionOnMutationEvents then
				pcall(function()
					local mutationActive = false
					for _, mutName in AllMutations do
						if mutName ~= "Normal" then
							if workspace:GetAttribute(mutName) ~= nil then
								mutationActive = true
								break
							end
						end
					end

					if (State.autoPotionOnMutationEvents and mutationActive) or State.autoLuckPotion then
						local hasLuckBuff = LocalPlayer:GetAttribute("Luck2x") == "true" or LocalPlayer:GetAttribute("SuperLuck") == "true" or LocalPlayer:GetAttribute("UltraLuck") == "true"
						if not hasLuckBuff then
							ItemUseRemote:FireServer("Luck Potion")
							ItemUseRemote:FireServer("Super Luck Potion")
							ItemUseRemote:FireServer("Ultra Luck Potion")
							ItemUseRemote:FireServer("Mutation Potion")
						end
					end
				end)
				task.wait(3)
			else
				task.wait(1.5)
			end
		end
	end)

	-- Auto Upgrade Loop (Stats)
	stopThread("autoUpgrade")
	activeThreads["autoUpgrade"] = task.spawn(function()
		while true do
			if Library.Unloaded then break end
			if State.autoUpgrade then
				pcall(function()
					local currentGold = getPlayerGold()
					local keepGold = tonumber(Options.KeepGold and Options.KeepGold.Value) or 0
					local selectedUpgrades = Options.UpgradeSelection and Options.UpgradeSelection.Value or {}

					for upgradeName, selected in selectedUpgrades do
						if selected then
							local currentLvl = DataServiceClient:get({ "Upgrades", upgradeName })
							if currentLvl == nil then
								currentLvl = UpgradesInfo.Upgrades.Default[upgradeName] or 1
							end

							if not UpgradesInfo.IsMaxed(upgradeName, currentLvl) then
								local price = UpgradesInfo.GetPrice(upgradeName, currentLvl)
								if price and (currentGold - price) >= keepGold then
									UpgradeRemote:FireServer("Gold", upgradeName)
									currentGold -= price
									task.wait(0.25)
								end
							end
						end
					end
				end)
				task.wait(1)
			else
				task.wait(0.5)
			end
		end
	end)

	-- Full Auto Level Up / Fusion Loop (Anime Characters)
	stopThread("autoLevelUp")
	activeThreads["autoLevelUp"] = task.spawn(function()
		while true do
			if Library.Unloaded then break end
			if State.autoLevelUp then
				pcall(performFullAutoFusion)
				task.wait(0.6)
			else
				task.wait(0.5)
			end
		end
	end)

	-- Auto Spin Wheel Loop
	stopThread("autoSpinWheel")
	activeThreads["autoSpinWheel"] = task.spawn(function()
		while true do
			if Library.Unloaded then break end
			if State.autoSpinWheel and not State.isSpinning then
				pcall(function()
					local spins = tonumber(DataServiceClient:get({ "Spin" })) or 0
					if spins > 0 then
						State.isSpinning = true
						SpinRemote:FireServer("Spin")
					end
				end)
				task.wait(2.5)
			else
				task.wait(0.5)
			end
		end
	end)

	-- Auto Battlepass & Quests Loop
	stopThread("autoBattlepass")
	activeThreads["autoBattlepass"] = task.spawn(function()
		while true do
			if Library.Unloaded then break end
			if State.autoClaimBattlepass or State.autoClaimQuests then
				pcall(function()
					local bpData = DataServiceClient:get({ "Battlepass" }) or {}
					local exp = tonumber(bpData.Exp) or 0
					local currentLvl, maxLvl = getBattlepassLevel(exp)

					if State.autoClaimBattlepass then
						local claimedFree = (bpData.Claimed and bpData.Claimed.Free) or {}
						local claimedPrem = (bpData.Claimed and bpData.Claimed.Premium) or {}
						local isPremOwned = bpData.Premium and bpData.Premium.Owned == true

						for lvl = 1, math.min(currentLvl, maxLvl) do
							if not claimedFree[tostring(lvl)] then
								BPClaim:FireServer(lvl, "Free")
								task.wait(0.2)
							end
							if isPremOwned and not claimedPrem[tostring(lvl)] then
								BPClaim:FireServer(lvl, "Premium")
								task.wait(0.2)
							end
						end
					end

					if State.autoClaimQuests then
						local questData = BPGetQuestData:InvokeServer()
						if questData then
							for _, category in { "Daily", "Weekly" } do
								local quests = questData[category] or {}
								for _, q in ipairs(quests) do
									local req = tonumber(q.Requirement) or 1
									local prog = tonumber(q.Progress) or 0
									if (q.Completed or prog >= req) and not q.Claimed then
										BPClaimQuest:FireServer(category, tostring(q.ID))
										task.wait(0.2)
									end
								end
							end
						end
					end
				end)
				task.wait(2)
			else
				task.wait(1)
			end
		end
	end)

	-- Auto Faction Quests Loop
	stopThread("autoFaction")
	activeThreads["autoFaction"] = task.spawn(function()
		while true do
			if Library.Unloaded then break end
			if State.autoClaimFactionQuests then
				pcall(function()
					FactionUpdate:FireServer("RequestQuestData")
					task.wait(0.5)

					if latestFactionQuests then
						for _, q in ipairs(latestFactionQuests) do
							local req = tonumber(q.Requirement) or 1
							local prog = tonumber(q.Progress) or 0
							if (q.Completed or prog >= req) and not q.Claimed then
								FactionUpdate:FireServer("ClaimFactionQuest", tostring(q.ID))
								task.wait(0.25)
							end
						end
					end
				end)
				task.wait(2.5)
			else
				task.wait(1)
			end
		end
	end)

	-- Fast Live UI Displays Refresher & Auto-Config Saver
	stopThread("uiRefresher")
	activeThreads["uiRefresher"] = task.spawn(function()
		local saveCounter = 0
		while true do
			if Library.Unloaded then break end
			updateUpgradeLevelsDisplay()
			updateSpinDisplay()
			updateBPDisplay()

			-- Periodic auto-save config (every 5 seconds)
			saveCounter += 1
			if State.autoSaveConfig and saveCounter >= 10 then
				saveCounter = 0
				pcall(function()
					SaveManager:Save("default")
				end)
			end

			task.wait(0.5)
		end
	end)
end

